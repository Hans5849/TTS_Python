[Unit]
Description=Audioconversion watched-directory TTS service
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
Environment=AUDIOCONVERSION_CONFIG=/etc/audioconversion/config.toml
EnvironmentFile=-/etc/audioconversion/secrets.env
ExecStart=@PROGRAM_DIR@/venv/bin/tts service run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
