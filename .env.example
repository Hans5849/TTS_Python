# Copy this file to .env and replace the placeholder. Never commit the real .env.
OPENAI_API_KEY=your-api-key-here

# Optional: use an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://example.com/v1

# Optional: process separate input files concurrently (valid range: 1-32).
# TTS_FILE_WORKERS=3

# Export chapters detected from source headings (true or false; default: false).
TTS_CHAPTERS=false
